# Vite reads these at BUILD time and writes the values straight into the
# bundle, so changing them in the hosting dashboard has no effect until
# the site is rebuilt — set them, then Redeploy. On Vercel, set them for
# All Environments, or preview deployments will build without them.
#
# Copy to .env for local development. Never commit the real file.

# --- Required. Without these the app cannot load anything. ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<the anon / publishable key, not the service role key>

# --- Optional; each one only disables the feature named. ---

# Bot username, no leading @. Used for share links and referral links
# (t.me/<bot>/app?startapp=...). Without it, sharing falls back to the
# plain page URL and referral links are not offered at all.
VITE_TELEGRAM_BOT_USERNAME=AnimetioMini_bot

# The Mini App's short name, i.e. the last part of t.me/<bot>/<short
# name>. Used by the standalone ABA payment page to send the viewer back
# into the Mini App.
VITE_TELEGRAM_MINIAPP_SHORT_NAME=App

# Community group invite link. Powers "invite a friend" and the "message
# the admin" support button; both are hidden when it is unset.
VITE_TELEGRAM_GROUP_LINK=https://t.me/<your group>
